--// Drag helper: mouse + touch
local function MakeDraggable(object, dragArea)
    local dragging = false
    local dragInput
    local dragStart
    local startPosition

    dragArea.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            dragStart = input.Position
            startPosition = object.Position

            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then
                    dragging = false
                end
            end)
        end
    end)

    dragArea.InputChanged:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseMovement
        or input.UserInputType == Enum.UserInputType.Touch then
            dragInput = input
        end
    end)

    UIS.InputChanged:Connect(function(input)
        if dragging and (input == dragInput
        or input.UserInputType == Enum.UserInputType.Touch) then
            local delta = input.Position - dragStart
            object.Position = UDim2.new(
                startPosition.X.Scale,
                startPosition.X.Offset + delta.X,
                startPosition.Y.Scale,
                startPosition.Y.Offset + delta.Y
            )
        end
    end)
end

MakeDraggable(Main, Header)
MakeDraggable(Toggle, Toggle)

--// Profile button click / drag
local toggleStart
local toggleMoved = false

Toggle.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1
    or input.UserInputType == Enum.UserInputType.Touch then
        toggleStart = input.Position
        toggleMoved = false
    end
end)

Toggle.InputChanged:Connect(function(input)
    if toggleStart and (
        input.UserInputType == Enum.UserInputType.MouseMovement
        or input.UserInputType == Enum.UserInputType.Touch
    ) then
        if (input.Position - toggleStart).Magnitude > 8 then
            toggleMoved = true
        end
    end
end)

Toggle.Activated:Connect(function()
    if not toggleMoved then
        Main.Visible = true
        Toggle.Visible = false
    end
end)

--// ESP objects
local ESP = {}

local function GetPart(character, ...)
    for _, name in ipairs({...}) do
        local part = character and character:FindFirstChild(name)
        if part then
            return part
        end
    end
end

local function CreateESP(player)
    if player == LP or ESP[player] then return end

    local billboard = Instance.new("BillboardGui")
    billboard.Name = "SR_NameHealth"
    billboard.Size = UDim2.fromOffset(150, 45)
    billboard.StudsOffset = Vector3.new(0, 3, 0)
    billboard.AlwaysOnTop = true
    billboard.Enabled = false
    billboard.Parent = PlayerGui

    local label = Instance.new("TextLabel")
    label.Size = UDim2.fromScale(1, 1)
    label.BackgroundTransparency = 1
    label.TextColor3 = Color3.fromRGB(255, 255, 255)
    label.TextStrokeTransparency = 0
    label.Font = Enum.Font.GothamBold
    label.TextSize = 14
    label.Parent = billboard

    local highlight = Instance.new("Highlight")
    highlight.FillColor = Color3.fromRGB(0, 130, 255)
    highlight.OutlineColor = Color3.fromRGB(80, 190, 255)
    highlight.Enabled = false
    highlight.Parent = workspace

    -- Tracer line
    local line = Instance.new("Frame")
    line.Name = "Tracer"
    line.AnchorPoint = Vector2.new(0, 0.5)
    line.BorderSizePixel = 0
    line.BackgroundColor3 = Color3.fromRGB(0, 170, 255)
    line.Visible = false
    line.Parent = Gui

    ESP[player] = {
        Billboard = billboard,
        Label = label,
        Highlight = highlight,
        Line = line
    }
end

local function RemoveESP(player)
    local data = ESP[player]
    if not data then return end

    data.Billboard:Destroy()
    data.Highlight:Destroy()
    data.Line:Destroy()
    ESP[player] = nil
end

for _, player in ipairs(Players:GetPlayers()) do
    CreateESP(player)
end

Players.PlayerAdded:Connect(CreateESP)
Players.PlayerRemoving:Connect(RemoveESP)

--// Update ESP
RunService.RenderStepped:Connect(function()
    Camera = workspace.CurrentCamera

    for player, data in pairs(ESP) do
        local character = player.Character
        local humanoid = character and character:FindFirstChildOfClass("Humanoid")
        local head = GetPart(character, "Head")
        local root = GetPart(character, "HumanoidRootPart")

        data.Line.Visible = false
        data.Billboard.Enabled = false
        data.Highlight.Enabled = false

        if character and humanoid and humanoid.Health > 0 then
            data.Billboard.Adornee = head
            data.Billboard.Enabled = head ~= nil
                and (Settings.Name or Settings.Health)

            local nameText = Settings.Name and player.Name or ""
            local healthText = Settings.Health
                and ("HP: " .. math.floor(humanoid.Health) .. "/" ..
                math.floor(humanoid.MaxHealth)) or ""

            data.Label.Text = nameText
            if nameText ~= "" and healthText ~= "" then
                data.Label.Text = nameText .. "\n" .. healthText
            elseif healthText ~= "" then
                data.Label.Text = healthText
            end

            data.Highlight.Adornee = character
            data.Highlight.Enabled = Settings.Player

            if Settings.Tracer and root then
                local myCharacter = LP.Character
                local myLeg = GetPart(
                    myCharacter,
                    "LeftFoot", "Left Leg",
                    "RightFoot", "Right Leg"
                )
                local targetLeg = GetPart(
                    character,
                    "LeftFoot", "Left Leg",
                    "RightFoot", "Right Leg"
                )

                if myLeg and targetLeg then
                    local fromPos, fromVisible =
                        Camera:WorldToViewportPoint(myLeg.Position)
                    local toPos, toVisible =
                        Camera:WorldToViewportPoint(targetLeg.Position)

                    if fromVisible and toVisible then
                        local startPoint = Vector2.new(fromPos.X, fromPos.Y)
                        local endPoint = Vector2.new(toPos.X, toPos.Y)
                        local difference = endPoint - startPoint

                        data.Line.Position = UDim2.fromOffset(
                            startPoint.X, startPoint.Y
                        )
                        data.Line.Size = UDim2.fromOffset(
                            difference.Magnitude, 2
                        )
                        data.Line.Rotation =
                            math.deg(math.atan2(difference.Y, difference.X))
                        data.Line.Visible = true
                    end
                end
            end
        end
    end
end)
